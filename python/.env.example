# ── LLM Configuration ──────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1   # 国内可用 DeepSeek/通义千问等兼容接口
OPENAI_MODEL=gpt-4o

# ── Embedding: "local" 核心镜像使用轻量 ONNX；安装 ML 依赖后使用下方 BGE ──
# 使用支持 /embeddings 的 OpenAI-compatible 服务时可改为 "api"
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── Neo4j ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Vector Store: chroma | pgvector | qdrant ──────
VECTOR_STORE_TYPE=qdrant          # 推荐 qdrant
CHROMA_HOST=localhost
CHROMA_PORT=8000
# CHROMA_PATH=./data/chroma      # 设置后走本地持久化模式 (无需 chroma server)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# Qdrant: 设置 QDRANT_URL 走服务端模式 (http://localhost:6333, 分布式)
#         留空则使用嵌入式本地模式 (QDRANT_PATH, 无需 Docker)
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_API_KEY=

# ── Reranker (检索精排) ────────────────────────────
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=20

# ── Self-RAG (自适应检索) ──────────────────────────
ENABLE_SELF_RAG=true
SELF_RAG_THRESHOLD=0.6
SELF_RAG_MAX_ROUNDS=2

# ── Kafka (CDC) ────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOC_CHANGES=doc-changes

# ── LangGraph Checkpointer: memory | redis | postgres ──
CHECKPOINT_BACKEND=memory
REDIS_URL=redis://localhost:6379
POSTGRES_CHECKPOINT_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# ── HITL 人机协同 (知识入库前人工审核) ──────────────
ENABLE_HITL=false

# ── 文档解析 / 语义分块 ────────────────────────────
# marker-pdf 首次运行需要下载大型模型；false 使用 pymupdf/pypdf 轻量路径
MARKER_ENABLED=false
SEMANTIC_CHUNK_ENABLED=true
CHUNK_BREAKPOINT_THRESHOLD=85
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── LangSmith 可观测性 (可选) ──────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-knowledge-hub
LANGSMITH_TRACING=false

# ── API ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=
MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_FILES=10
MAX_QUESTION_LENGTH=4000
UPLOAD_DIR=./uploads
